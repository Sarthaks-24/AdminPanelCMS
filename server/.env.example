# Copy this file to server/.env and fill it in. Never commit server/.env.
# Full reference: docs/ENVIRONMENT.md

# ══════════════════════════════════════════════════════════════════════════════
# MODE: the one switch between local development and production.
#   dev   uses the DEV_* values below and runs with NODE_ENV=development
#   prod  uses the PROD_* values below and runs with NODE_ENV=production
#         (Secure cookies, no stack traces in responses, https checks at boot)
# Do not set NODE_ENV yourself; MODE sets it.
# On a hosting platform you can set MODE=prod plus the plain names (MONGODB_URI,
# JWT_SECRET, ...) in its dashboard instead of the PROD_* names.
# ══════════════════════════════════════════════════════════════════════════════
MODE=dev

# ── Changes between dev and prod: DEVELOPMENT values (used when MODE=dev) ─────
# Local or non-production database. Include the database name in the path.
DEV_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/Portfolio_dev?retryWrites=true&w=majority
# Random string of 32+ characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DEV_JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_replace_me
# Exact origin of the dashboard (scheme + host + port, no trailing slash). Used for CORS and emailed links.
DEV_CLIENT_ORIGIN=http://localhost:5173
# Reverse proxies in front of Node. 0 when you open http://localhost:5000 directly.
DEV_TRUST_PROXY_HOPS=0
# lax (default), strict or none.
DEV_SESSION_COOKIE_SAMESITE=lax
# invite, open, or closed. A superadmin can override this from the dashboard.
DEV_SIGNUP_MODE=invite
# Only enforced in production; has no effect in dev.
DEV_LEGAL_POLICIES_APPROVED=false
# Resend API key. With the placeholder no email is sent, so accounts made on the signup page cannot be
# verified locally; `npm run setup` creates an already-verified account.
DEV_RESEND_MAIL_KEY=re_xxxxxxxxx
DEV_RESEND_FROM_EMAIL=onboarding@resend.dev
# Password for the first account, created by `npm run setup` (10+ characters).
DEV_ADMIN_PASSWORD=change-this-local-password
# rclone destination for encrypted backups. Optional in dev.
DEV_BACKUP_REMOTE_DESTINATION=

# ── Changes between dev and prod: PRODUCTION values (used when MODE=prod) ─────
# The production database. Never reuse the development database or its credentials.
PROD_MONGODB_URI=
# A different random 32+ character secret from development. Changing it signs everyone out.
PROD_JWT_SECRET=
# https origin the dashboard is served from, for example https://cms.example.com
PROD_CLIENT_ORIGIN=
# Required. 1 behind one reverse proxy or platform router (Render, Railway, Fly, nginx); 0 only if Node is exposed directly.
PROD_TRUST_PROXY_HOPS=1
# lax when the dashboard and API share a site (cms.example.com + api.example.com, or one origin).
# none only when they are on unrelated domains; some browsers block that.
PROD_SESSION_COOKIE_SAMESITE=lax
# closed until you are ready for other people to register.
PROD_SIGNUP_MODE=closed
# Signup stays off in production until this is true, whatever PROD_SIGNUP_MODE says.
PROD_LEGAL_POLICIES_APPROVED=false
# Live Resend key and a sender on a domain you have verified with Resend.
PROD_RESEND_MAIL_KEY=
PROD_RESEND_FROM_EMAIL=
# Only for `npm run setup` / `npm run admin` against production. Leave blank if you use
# `npm run production:prepare`, which asks for the password itself.
PROD_ADMIN_PASSWORD=
# Required for `npm run backup` in production: off-host rclone destination, e.g. remote:cms-backups
PROD_BACKUP_REMOTE_DESTINATION=

# ── Same in both modes ───────────────────────────────────────────────────────
# Port the API listens on. Most hosts inject PORT themselves.
PORT=5000

# First account, created or updated by `npm run setup`.
ADMIN_NAME=Your Full Name
ADMIN_EMAIL=mail@example.com

# Optional separate secret for hashing invite codes (32+ characters). Blank uses JWT_SECRET.
# Keep it stable: changing it invalidates outstanding invites.
INVITE_CODE_PEPPER=

# Wrong invite codes allowed per hour, across all visitors, before invite signup pauses.
INVITE_FAILURE_LIMIT=100

# Hours between automatic cleanups of deleted accounts while the server runs. 0 disables.
SWEEP_DELETED_INTERVAL_HOURS=6

# Database name used only when MONGODB_URI has no database in its path.
MONGODB_DB=

# `npm run stats` warns at 70% of this many bytes (default 512 MiB, the Atlas free tier).
DB_STORAGE_CAP_BYTES=536870912

# `npm run tokens:notify-expiring` emails owners this many days before an API token expires.
TOKEN_EXPIRY_WARNING_DAYS=7

# Encrypted backups (`npm run backup`, `npm run backup:verify`). Keep the passphrase file away from the archives.
BACKUP_PASSPHRASE_FILE=
BACKUP_DIR=
RCLONE_BINARY=rclone
GPG_BINARY=gpg
MONGORESTORE_BINARY=mongorestore
# Restore drill target. Must be a local, disposable MongoDB server.
BACKUP_RESTORE_URI=mongodb://127.0.0.1:27017

# Used only by `npm run update-resume`.
RESUME_DRIVE_URL=
