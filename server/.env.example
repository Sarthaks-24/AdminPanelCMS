# Copy this file to server/.env and fill it in. Never commit server/.env.
# Full reference: docs/ENVIRONMENT.md

# ══════════════════════════════════════════════════════════════════════════════
# MODE: the one switch between local development and production.
#   dev   uses the DEV_* values below and runs with NODE_ENV=development
#   prod  uses the PROD_* values below and runs with NODE_ENV=production
#         (Secure cookies, no stack traces in responses, https checks at boot)
# Do not set NODE_ENV yourself; MODE sets it.
# On a hosting platform you can set MODE=prod plus the plain names (MONGODB_URI,
# JWT_SECRET, ...) in its dashboard instead of the PROD_* names.
# ══════════════════════════════════════════════════════════════════════════════
MODE=dev

# ── Changes between dev and prod: DEVELOPMENT values (used when MODE=dev) ─────
# Local or non-production database. Include the database name in the path.
DEV_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/Portfolio_dev?retryWrites=true&w=majority
# Random string of 32+ characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DEV_JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_replace_me
# Exact origin of the dashboard (scheme + host + port, no trailing slash). Used for CORS and emailed links.
DEV_CLIENT_ORIGIN=http://localhost:5173
# Public base of this API as tenants' apps reach it (bare origin, no path, no trailing slash). The dashboard
# shows it as the /v1 base URL. Optional in dev (blank derives it from the dashboard's own API URL); required in prod.
DEV_PUBLIC_API_URL=http://localhost:5000
# Reverse proxies in front of Node. 0 when you open http://localhost:5000 directly.
DEV_TRUST_PROXY_HOPS=0
# lax (default), strict or none.
DEV_SESSION_COOKIE_SAMESITE=lax
# closed (default when blank), invite, or open. A superadmin can override this from the dashboard,
# including setting it back to closed.
DEV_SIGNUP_MODE=invite
# Only enforced in production; has no effect in dev.
DEV_LEGAL_POLICIES_APPROVED=false
# Resend API key. With the placeholder nothing is sent: in dev every email (with its links) is printed in the
# server log instead (see DEV_MAIL_TRANSPORT), so the signup can be walked locally.
DEV_RESEND_MAIL_KEY=re_xxxxxxxxx
DEV_RESEND_FROM_EMAIL=onboarding@resend.dev
# Password for the first account, created by `npm run setup` (10+ characters).
DEV_ADMIN_PASSWORD=change-this-local-password
# rclone destination for encrypted backups. Optional in dev.
DEV_BACKUP_REMOTE_DESTINATION=
# Secret for hashing invite codes (32+ characters). Optional in dev: blank uses DEV_JWT_SECRET.
DEV_INVITE_CODE_PEPPER=
# Cloudflare Turnstile keys (both or neither). Blank = no captcha. For local testing Cloudflare's test keys work
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA); production refuses them.
DEV_TURNSTILE_SECRET_KEY=
DEV_TURNSTILE_SITE_KEY=
# console prints each email (recipient, subject, text with links) to the server log instead of sending it.
# resend sends through Resend. Blank in dev = console while DEV_RESEND_MAIL_KEY is the placeholder.
DEV_MAIL_TRANSPORT=console

# ── Changes between dev and prod: PRODUCTION values (used when MODE=prod) ─────
# The production database. Never reuse the development database or its credentials.
PROD_MONGODB_URI=
# A different random 32+ character secret from development. Changing it signs everyone out.
PROD_JWT_SECRET=
# https origin the dashboard is served from, for example https://cms.example.com
PROD_CLIENT_ORIGIN=
# Required. https origin tenants call for /v1, for example https://api.example.com (bare origin, no path or
# trailing slash; the boot check refuses anything else). The dashboard shows it as the /v1 base URL. It must be
# on the same site as PROD_CLIENT_ORIGIN (app.example.com + api.example.com): free platform hostnames such as
# *.onrender.com, *.up.railway.app or *.pages.dev are each their own site, and the boot refuses that pair.
PROD_PUBLIC_API_URL=
# Required, deliberately blank: how many reverse proxies sit in front of Node. 1 behind Render, Railway, Fly or
# one reverse proxy (nginx, Caddy); 2 with a CDN in front of that proxy; 0 only if Node is reached directly.
# Wrong values make every visitor share one IP for rate limits, or let clients forge their IP.
PROD_TRUST_PROXY_HOPS=
# lax (default) when the dashboard and API share a site (app.example.com + api.example.com, or one origin).
# none is not a fix for two sites: Safari and other browsers block that cookie.
PROD_SESSION_COOKIE_SAMESITE=lax
# closed (the default) until you are ready for other people to register; then invite, later open.
PROD_SIGNUP_MODE=closed
# Signup stays off in production until this is true, whatever PROD_SIGNUP_MODE says.
PROD_LEGAL_POLICIES_APPROVED=false
# Live Resend key and a sender on a domain you have verified with Resend. In production a missing key, a
# @resend.dev sender, or a blank OPERATOR_NAME / SUPPORT_EMAIL refuses to boot unless PROD_SIGNUP_MODE=closed;
# then it is a warning, and signup cannot be opened from the dashboard (409 mail_not_ready) until it is fixed.
PROD_RESEND_MAIL_KEY=
PROD_RESEND_FROM_EMAIL=
# Only for `npm run setup` / `npm run admin` against production. Leave blank if you use
# `npm run production:prepare`, which asks for the password itself (`npm run admin` also reads stdin).
PROD_ADMIN_PASSWORD=
# Required for `npm run backup` in production: off-host rclone destination, e.g. remote:cms-backups
PROD_BACKUP_REMOTE_DESTINATION=
# Required in production: a random 32+ character secret, different from PROD_JWT_SECRET, for hashing invite
# codes. Keep it stable (changing it invalidates outstanding invites); JWT_SECRET can then rotate freely.
PROD_INVITE_CODE_PEPPER=
# Your Turnstile widget's keys, both or neither (blank = no captcha). One without the other, or Cloudflare's
# test keys, refuse to boot. Add the dashboard hostname to the widget in the Cloudflare dashboard.
PROD_TURNSTILE_SECRET_KEY=
PROD_TURNSTILE_SITE_KEY=
# Blank (= resend). console is refused in production; MAIL_DELIVERY=disabled is the production escape hatch.
PROD_MAIL_TRANSPORT=

# ── Same in both modes ───────────────────────────────────────────────────────
# Blank, or `disabled`. `disabled` turns account email off on purpose: nothing is sent, every message is
# printed to the log, and /signup answers with the verification link instead of mailing it, so the browser
# that asked goes straight to the password step. It exists for a deployment with no verified sending domain,
# where the alternative is a signup form that creates accounts nobody can finish, because the password is only
# set from that link. It proves nothing about who owns the address, so anyone who can type one gets a working
# account at it: never run a service real people sign up to this way. Unset it once a sender is verified.
MAIL_DELIVERY=
# Port the API listens on. Most hosts inject PORT themselves.
PORT=5000

# First account, created or updated by `npm run setup`.
ADMIN_NAME=Your Full Name
ADMIN_EMAIL=mail@example.com

# Wrong invite codes allowed per hour from one source (an IPv4 address or an IPv6 /48) before it is locked
# out (429 invite_locked).
INVITE_IP_FAILURE_LIMIT=10
# Wrong invite codes per hour across all visitors that raise the `invite_failures_high` alert. It no longer
# locks invites for everyone.
INVITE_FAILURE_LIMIT=2000

# Numeric settings below: blank = the default shown in the comment; only an explicit 0 disables a guard that
# allows it (production logs it as DISABLED). A value that is not a number refuses to boot in production.

# New signups per email domain per UTC day (in memory). Blank = 50; 0 disables.
SIGNUP_DOMAIN_DAILY_CAP=50
# Optional cap on accounts (every account that is not deleted). Blank or 0 = no cap; at the cap signup closes.
MAX_ACCOUNTS=
# Concurrent bcrypt compares allowed during login; beyond it login answers 503 busy.
BCRYPT_MAX_CONCURRENT=4

# Outbound email budget per UTC day (verification, account-exists and reset mail). Over the cap, signup and
# resend answer 503 mail_budget. The last MAIL_RESET_RESERVE of the cap can only be spent on password resets.
# Blank = 95 and 20, which fit the Resend free tier (100 a day, 3,000 a month). Raise both on a paid plan;
# production warns when the cap is above 100.
MAIL_DAILY_CAP=
MAIL_RESET_RESERVE=

# Who the account emails come from (subjects, header and footer). PRODUCT_NAME defaults to "Portfolio Control".
# OPERATOR_NAME (the person or company running the service) and SUPPORT_EMAIL (a plain address that replies) are
# required before production signup can open: mail without them reads as phishing.
PRODUCT_NAME=
OPERATOR_NAME=
SUPPORT_EMAIL=

# pino log level: trace, debug, info (default), warn, error, silent. Tests run silent.
LOG_LEVEL=info

# Hours between automatic cleanups while the server runs (deleted accounts, and signups that never verified
# within 48 hours). Blank = 6; 0 disables.
SWEEP_DELETED_INTERVAL_HOURS=6

# After SIGTERM, /readyz answers 503 for this many milliseconds before the listener closes, so the platform stops
# routing here first. Blank = 5000. Set it to the platform's readiness probe interval, and give the platform a stop
# grace period of at least SHUTDOWN_DELAY_MS + 10 s (docs/DEPLOYMENT.md).
SHUTDOWN_DELAY_MS=

# Database name used only when MONGODB_URI has no database in its path.
MONGODB_DB=

# Storage guard. The server checks dbStats every STORAGE_CHECK_INTERVAL_MINUTES (blank = 10; 0 disables). At
# STORAGE_WARN_PERCENT of DB_STORAGE_CAP_BYTES it logs the storage_high alert; at STORAGE_BLOCK_PERCENT it closes
# signup and refuses content writes with 503 storage_full. `npm run stats` warns at 70% of the same cap.
DB_STORAGE_CAP_BYTES=536870912
STORAGE_CHECK_INTERVAL_MINUTES=10
STORAGE_WARN_PERCENT=70
STORAGE_BLOCK_PERCENT=90

# API token expiry notices: the server emails owners this many days before a token expires, checking every
# TOKEN_EXPIRY_NOTICE_INTERVAL_HOURS (blank = 24; 0 disables; `npm run tokens:notify-expiring` runs it once by hand).
TOKEN_EXPIRY_WARNING_DAYS=7
TOKEN_EXPIRY_NOTICE_INTERVAL_HOURS=24

# Burst alert thresholds per minute (lib/alerts.js, docs/OPERATIONS.md#alerts).
ALERT_429_PER_MINUTE=100
ALERT_TOKEN_INVALID_PER_MINUTE=30

# Encrypted backups (`npm run backup`, `npm run backup:verify`). Keep the passphrase file away from the archives.
BACKUP_PASSPHRASE_FILE=
BACKUP_DIR=
# Days of archives kept in the backup destination. Blank = 30 (whole days, 1 to 3650).
BACKUP_RETENTION_DAYS=
RCLONE_BINARY=rclone
GPG_BINARY=gpg
MONGORESTORE_BINARY=mongorestore
# Restore drill target. Must be a local, disposable MongoDB server.
BACKUP_RESTORE_URI=mongodb://127.0.0.1:27017

# Used only by `npm run update-resume`.
RESUME_DRIVE_URL=
