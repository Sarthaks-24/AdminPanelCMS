# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and database name with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/Portfolio_db?retryWrites=true&w=majority

# JWT Authentication Secret
# Set a strong, random 32+ character key for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_replace_me
# Optional separate random secret for keyed invite-code hashes. Keep it stable across deployments;
# leave blank to use JWT_SECRET, or set a unique random secret of 32+ characters.
INVITE_CODE_PEPPER=

# Admin CMS Identity & Credentials
# Used by `npm run setup` and default model initialization
ADMIN_NAME=Your Full Name
ADMIN_EMAIL=mail@example.com
ADMIN_PASSWORD=supersecureadminpassword123

# CORS Configuration
# Exact dashboard frontend origin allowed to make requests to this backend.
# For local, deployment-like tests, keep the client at this exact localhost origin.
CLIENT_ORIGIN=http://localhost:5173

# Set this only when Node is behind a trusted reverse proxy. Use 0 when accessing Node directly.
# For one trusted proxy that overwrites X-Forwarded-For, set this to 1.
TRUST_PROXY_HOPS=0

# Resume Google Drive Public Link
# The shareable URL to your resume PDF on Google Drive.
# Update this link here and run `npm run update-resume` in /server to sync it into MongoDB.
RESUME_DRIVE_URL=https://drive.google.com/file/d/YOUR_GOOGLE_DRIVE_FILE_ID/view?usp=sharing


# Resend API key. Replace re_xxxxxxxxx with your real API key from the Resend dashboard.
# Keep this secret in server/.env; never expose it through a VITE_ variable or commit it.
RESEND_MAIL_KEY=re_xxxxxxxxx
# Sender address. onboarding@resend.dev is for initial testing; use an address on a verified domain for production.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Set to true only after the Terms of Service and Privacy Policy have been approved for production.
LEGAL_POLICIES_APPROVED=false

# Storage alert cap used by `npm run stats` (default: 512 MiB). At 70%, the command exits 2 and asks the operator to keep signup invite-only.
DB_STORAGE_CAP_BYTES=536870912
# Send one reminder per API token within this many days of expiry.
TOKEN_EXPIRY_WARNING_DAYS=7

# Encrypted backup operations. Keep the passphrase file separate from backup archives.
BACKUP_PASSPHRASE_FILE=
BACKUP_DIR=
# Configure this rclone destination before production backups; production mode refuses local-only backups.
BACKUP_REMOTE_DESTINATION=
RCLONE_BINARY=rclone
GPG_BINARY=gpg
MONGORESTORE_BINARY=mongorestore
# Restore verification only: must be a local disposable MongoDB server.
BACKUP_RESTORE_URI=mongodb://127.0.0.1:27017
