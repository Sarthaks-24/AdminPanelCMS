# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and database name with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/Portfolio_db?retryWrites=true&w=majority

# JWT Authentication Secret
# Set a strong, random 32+ character key for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_replace_me

# Admin CMS Identity & Credentials
# Used by `npm run setup` and default model initialization
ADMIN_NAME=Your Full Name
ADMIN_EMAIL=mail@example.com
ADMIN_PASSWORD=supersecureadminpassword123

# CORS Configuration
# Origin of the frontend client allowed to make requests to this backend.
# You can specify multiple origins or comma-separate if needed in production.
CLIENT_ORIGIN=http://localhost:5173

# Resume Google Drive Public Link
# The shareable URL to your resume PDF on Google Drive.
# Update this link here and run `npm run update-resume` in /server to sync it into MongoDB.
RESUME_DRIVE_URL=https://drive.google.com/file/d/YOUR_GOOGLE_DRIVE_FILE_ID/view?usp=sharing

