# Copy this file to client/.env. Values are baked into the bundle at build time, so they are
# public: never put a secret in a VITE_ variable. Full reference: docs/ENVIRONMENT.md

# ══════════════════════════════════════════════════════════════════════════════
# VITE_MODE: the one switch between local development and production.
#   dev   the dashboard calls VITE_DEV_API_URL
#   prod  the dashboard calls VITE_PROD_API_URL
# Set it to prod before `npm run build` for a production deploy.
# ══════════════════════════════════════════════════════════════════════════════
VITE_MODE=dev

# ── Changes between dev and prod ─────────────────────────────────────────────
# Base URL of the dashboard API, ending in /api.
VITE_DEV_API_URL=http://localhost:5000/api
# Full https URL of the deployed API, or just /api when the dashboard and API share one origin.
VITE_PROD_API_URL=/api
