# Copy this file to client/.env, or set the same variables in the static host's build settings
# (VITE_* in the build process env override client/.env). Values are baked into the bundle at build
# time, so they are public: never put a secret in a VITE_ variable. Full reference: docs/ENVIRONMENT.md
#
# vite.config.js validates every value below (config/buildEnv.js). A prod build with a missing or
# invalid required value FAILS with a message naming the variable; it never falls back silently.
# `npm run check:launch` additionally reports placeholder and example.com values.

# ══════════════════════════════════════════════════════════════════════════════
# VITE_MODE: the one switch between local development and production.
#   dev   the dashboard calls VITE_DEV_API_URL; identity values may be left unset
#   prod  the dashboard calls VITE_PROD_API_URL; the values marked "required in prod" must be set
# Unset: `vite build` means prod and `npm run dev` means dev (the build prints which one it used).
# Any other value (a typo such as `prd`) fails the build.
# ══════════════════════════════════════════════════════════════════════════════
VITE_MODE=dev

# ── API ──────────────────────────────────────────────────────────────────────
# The API origin, with or without a trailing /api (both become <origin>/api). No other path.
# Dev: optional, default http://localhost:5000. http is allowed.
VITE_DEV_API_URL=http://localhost:5000
# Prod: REQUIRED. https only, not localhost, e.g. https://api.portfoliocontrol.dev. Its origin also
# goes into the CSP connect-src (dist/_headers and the <meta> in index.html). The API must be on the
# same registrable domain as the dashboard, or the session cookie is never sent.
VITE_PROD_API_URL=https://api.example.com

# ── Site identity (shown on the public pages, the Terms and the Privacy Policy) ─
# The public host of the dashboard, without scheme or path, e.g. portfoliocontrol.dev. Used for the
# canonical URL, social cards, security.txt and the default mailboxes. REQUIRED in prod.
VITE_SITE_DOMAIN=
# Product name. Optional; default "Portfolio Control".
VITE_SITE_NAME=
# The person or registered business that runs the service and is party to the Terms, e.g. "Jane Doe".
# REQUIRED in prod.
VITE_SITE_OPERATOR=
# The country or state whose law governs the Terms, e.g. "India". REQUIRED in prod.
VITE_SITE_JURISDICTION=
# The address every "contact support" message shows. Optional; default support@<VITE_SITE_DOMAIN>.
# Keep it equal to the server's SUPPORT_EMAIL.
VITE_SITE_SUPPORT_EMAIL=
# Who runs the API and dashboard servers, e.g. "Render Services, Inc.". Quoted in the Privacy Policy.
# Optional for the build; check:launch fails while unset.
VITE_SITE_HOSTING_PROVIDER=
# Where the encrypted off-host backups are stored, e.g. "Cloudflare R2". Optional for the build;
# check:launch fails while unset.
VITE_SITE_BACKUP_PROVIDER=
# Where request logs are shipped and retained, e.g. "Better Stack". Optional for the build;
# check:launch fails while unset.
VITE_SITE_LOG_PROVIDER=
# Public uptime page (https), shown in the footer. Optional; unset hides the link.
VITE_SITE_STATUS_URL=
