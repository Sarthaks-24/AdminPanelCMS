# Security headers for the static site and dashboard (Netlify / Cloudflare Pages `_headers` syntax).
#
# This file is a template. The build (config/deployFiles.js) writes dist/_headers from it, replacing
# the CSP token below with the policy from config/csp.js: script-src carries the sha256 of the inline
# theme script, connect-src the API origin from VITE_PROD_API_URL. The same policy goes into
# dist/index.html as a <meta> for hosts that ignore _headers (Render static sites, Caddy).
# `npm run check:dist` fails if a token is left over or the policy misses the API origin.
/*
  Content-Security-Policy: %CSP%
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
